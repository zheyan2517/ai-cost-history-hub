# systemd service unit for history-hub-server (AI Cost History Hub)
#
# Installation:
#   1. Copy this file:
#      sudo cp history-hub.service /etc/systemd/system/history-hub.service
#
#   2. Edit the file �?set User= to your username:
#      sudo systemctl edit --full history-hub.service
#
#   3. Enable and start:
#      sudo systemctl enable --now history-hub.service
#
#   4. Check status:
#      sudo systemctl status history-hub.service
#
#   5. View logs:
#      journalctl -u history-hub.service -f

[Unit]
Description=AI Cost History Hub (WebUI Server)
After=network.target

[Service]
Type=simple
# IMPORTANT: Change this to the user whose ~/.claude directory you want to serve.
User=YOUR_USERNAME_HERE
WorkingDirectory=/home/YOUR_USERNAME_HERE
ExecStart=/usr/local/bin/history-hub-server --serve --host 0.0.0.0
Restart=on-failure
RestartSec=5

# To require a fixed access token, use either the --token flag or history-hub_TOKEN env var:
# ExecStart=/usr/local/bin/history-hub-server --serve --host 0.0.0.0 --token your-secret-token
# Or via environment variable:
# Environment=history-hub_TOKEN=your-secret-token

# ── Security hardening ──
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

# ── Resource limits ──
MemoryMax=512M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
